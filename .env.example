# Set to true to use the PHP + MySQL API in dev (run: php -S localhost:8000 -t .)
VITE_USE_PHP_API=false

# EmailJS (browser, PUBLIC values only). Copy this file to .env.local and fill in.
# Dashboard: Email Services -> Service ID, Email Templates -> Template ID, Account -> Public Key.
# NEVER put the EmailJS Private Key in any VITE_ variable.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
